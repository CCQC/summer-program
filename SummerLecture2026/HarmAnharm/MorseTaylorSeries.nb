Cell[BoxData[{
 RowBox[{
  RowBox[{"SubMorse2", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"5.`", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "1.`"}], " ", "x"}]]}], "-", 
   RowBox[{"5.`", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "0.5`"}], " ", "x"}]], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "0.5`"}], " ", "x"}]]}], 
     ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"SubMorse2", "[", "0", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Morse2", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"SubMorse2", "[", "0", "]"}], "*", 
    SuperscriptBox["x", "2"]}], "+", 
